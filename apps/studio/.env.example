# Sanity Studio — miljøvariabler
# Kopier denne filen til .env.local og fyll inn verdier

# Sanity-prosjekt (finn på sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Preview-URL (web-appen)
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Delt hemmelighet for draft mode — må matche SANITY_PREVIEW_SECRET i web-appen
# SANITY_STUDIO_PREVIEW_SECRET=change-me

# For "Test this skill"-funksjonen (trinn 8)
# HANDBOOK_ANTHROPIC_API_KEY=
