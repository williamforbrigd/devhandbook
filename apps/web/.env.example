# Next.js web-app — miljøvariabler
# Kopier denne filen til .env.local og fyll inn verdier

# Sanity-prosjekt
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API-token for server-side datahenting (read-only, ikke secret)
# SANITY_API_READ_TOKEN=

# Delt hemmelighet for å aktivere draft mode fra Presentation tool
# SANITY_PREVIEW_SECRET=change-me

# Anthropic API-nøkkel for "Test this skill"-funksjonen
# HANDBOOK_ANTHROPIC_API_KEY=

# Studio-URL brukt i stega-encoding (Visual Editing)
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
